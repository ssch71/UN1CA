# UN1CA z3q boot debugging, see /system/etc/unica_bootlog.sh. Started in
# early-fs. Note: init has no escapes inside quotes, so keep shell code in
# the script and not in this file.
service unica_bootlog /system/bin/sh /system/etc/unica_bootlog.sh kmsg
    user root
    group root log
    seclabel u:r:unica_bootlog:s0
    disabled

service unica_bootlog_file /system/bin/sh /system/etc/unica_bootlog.sh file
    user root
    group root log
    seclabel u:r:unica_bootlog:s0
    disabled

on early-fs
    start unica_bootlog
    start unica_bootlog_file
