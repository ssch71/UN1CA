# UN1CA z3q boot debugging. Start the logcat mirrors explicitly in early-fs.
# Output goes to kmsg (/proc/last_kmsg) and to /metadata (readable from
# recovery without decrypting /data).
# init fails to stat /system/bin/logcat directly ("Cannot find ...:
# Permission denied"), so go through sh, which init starts fine elsewhere.
# logcat is restarted if it exits (e.g. logd not up yet).
service unica_bootlog /system/bin/sh -c "echo 'unica_bootlog: started' > /dev/kmsg; while true; do /system/bin/logcat -b main -b system -b crash -v brief -f /dev/kmsg *:I; sleep 1; done"
    user root
    group root log
    seclabel u:r:unica_bootlog:s0
    disabled

service unica_bootlog_file /system/bin/sh -c "while true; do /system/bin/logcat -b all -v threadtime -f /metadata/unica_boot.log -r 4096 -n 2; sleep 1; done"
    user root
    group root log
    seclabel u:r:unica_bootlog:s0
    disabled

on early-fs
    start unica_bootlog
    start unica_bootlog_file
