From ae65146218fce370f9825728776bb0c4951f805b Mon Sep 17 00:00:00 2001
From: ssch71 <ssch71@users.noreply.github.com>
Date: Sat, 31 Oct 2026 01:13:56 +0900
Subject: [PATCH] Add RESOLUTION_4032X1728

SM8250 camera-feature.xml uses 4032x1728 as the 21:9 video snapshot size, which the S23 camera app does not know.
---
 smali_classes2/l9/a2.smali | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/smali_classes2/l9/a2.smali b/smali_classes2/l9/a2.smali
index 19a327c..91fd4b7 100644
--- a/smali_classes2/l9/a2.smali
+++ b/smali_classes2/l9/a2.smali
@@ -516,6 +516,8 @@
 
 .field public static final enum RESOLUTION_960X960:Ll9/a2;
 
+.field public static final enum RESOLUTION_4032X1728:Ll9/a2;
+
 .field private static final mIdMap:Ljava/util/Map;
     .annotation system Ldalvik/annotation/Signature;
         value = {
@@ -4774,6 +4776,26 @@
 
     sput-object v33, Ll9/a2;->RESOLUTION_4640X1988:Ll9/a2;
 
+    new-instance v0, Ll9/a2;
+
+    const-string v1, "RESOLUTION_4032X1728"
+
+    const/16 v2, 0xff
+
+    const/16 v3, 0x11c
+
+    const/16 v4, 0xfc0
+
+    const/16 v5, 0x6c0
+
+    sget-object v6, Ll9/b;->RATIO_21x9:Ll9/b;
+
+    const/16 v7, 0x1e
+
+    invoke-direct/range {v0 .. v7}, Ll9/a2;-><init>(Ljava/lang/String;IIIILl9/b;I)V
+
+    sput-object v0, Ll9/a2;->RESOLUTION_4032X1728:Ll9/a2;
+
     invoke-static {}, Ll9/a2;->b()[Ll9/a2;
 
     move-result-object v0
@@ -4914,7 +4936,7 @@
 .method public static synthetic b()[Ll9/a2;
     .locals 3
 
-    const/16 v0, 0xff
+    const/16 v0, 0x100
 
     new-array v0, v0, [Ll9/a2;
 
@@ -6448,6 +6470,12 @@
 
     aput-object v1, v0, v2
 
+    sget-object v1, Ll9/a2;->RESOLUTION_4032X1728:Ll9/a2;
+
+    const/16 v2, 0xff
+
+    aput-object v1, v0, v2
+
     return-object v0
 .end method
 
