From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ssch71 <ssch71@users.noreply.github.com>
Date: Sat, 24 Oct 2026 13:10:00 +0900
Subject: [PATCH] Disable SUPPORT_A2DPSINK_PROFILE support

One UI 9.0 rebase: InstantProfile now logs "SINK service is not supported
by this model" and returns for the A2DP sink register/enable actions instead
of starting the sink service, matching builds without A2DP sink.
---
diff --git a/smali/com/samsung/bt/a2dp/InstantProfile$1.smali b/smali/com/samsung/bt/a2dp/InstantProfile$1.smali
--- a/smali/com/samsung/bt/a2dp/InstantProfile$1.smali
+++ b/smali/com/samsung/bt/a2dp/InstantProfile$1.smali
@@ -111,6 +111,12 @@
 
     :cond_2
     :goto_0
+    const-string p0, "SINK service is not supported by this model"
+
+    invoke-static {v1, p0}, Landroid/util/Log;->d(Ljava/lang/String;Ljava/lang/String;)I
+
+    return-void
+
     iget-object v0, p0, Lcom/samsung/bt/a2dp/InstantProfile$1;->this$0:Lcom/samsung/bt/a2dp/InstantProfile;
 
     const-string v2, "bluetooth_a2dp_sink_mode"
-- 
2.47.0
