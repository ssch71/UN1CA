+
+    goto :check_enabled
+
+    :check_first_api
+    const-string v0, "ro.product.first_api_level"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-eqz v0, :no_override
+
+    sget-object p0, Lio/mesalabs/unica/PlayIntegrityHooks;->sPifFirstApiLevel:Ljava/lang/String;
+
+    :check_enabled
+    if-eqz p0, :no_override
