@@ -1030,3 +1038,46 @@
     :cond_a
     return-void
 .end method
+
+.method public static onSystemPropertiesGet(Ljava/lang/String;)Ljava/lang/String;
+    .locals 1
+
+    const-string v0, "ro.build.version.security_patch"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
