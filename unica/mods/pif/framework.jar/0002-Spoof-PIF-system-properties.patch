+    invoke-static {}, Lio/mesalabs/unica/PlayIntegrityHooks;->isPIFEnabled()Z
+
+    move-result v0
+
+    if-eqz v0, :no_override
+
+    return-object p0
+
+    :no_override
+    const/4 v0, 0x0
+
+    return-object v0
+.end method
