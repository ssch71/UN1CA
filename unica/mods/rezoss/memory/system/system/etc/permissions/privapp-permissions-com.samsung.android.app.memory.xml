<?xml version="1.0" encoding="utf-8"?>
<!-- Only requested permissions carrying the privileged flag in dm3q framework-res.
     Signature-only permissions rely on the original Samsung platform certificate.
     Runtime permissions remain under the app's normal consent flow. -->
<permissions>
    <privapp-permissions package="com.samsung.android.app.memory">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.READ_SEARCH_INDEXABLES"/>
        <permission name="android.permission.REAL_GET_TASKS"/>
        <permission name="android.permission.SCHEDULE_EXACT_ALARM"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
</permissions>
