From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica.local>
Date: Fri, 25 Sep 2026 00:00:00 +0200
Subject: [PATCH] Route Now Nudge replies through UN1CA Qwen provider

Bypass Samsung's native NowNudgeConversationActionsHandler for notification
assistant requests after the existing extras synthesis gate.  The native path
falls back into Samsung AIOS/SSNeural/QNN and returns empty or crashes on the
SM8550 port.

Call the local Qwen HTTP server directly, then convert its line-based output
into Android text-reply ConversationActions.  Logs only
structural status, never notification text or generated replies.

--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -31,9 +31,12 @@
     <uses-permission android:name="com.samsung.android.app.paynow.permission.PAY_NOW"/>
     <uses-permission android:name="com.samsung.android.settings.permission.LAUNCH_MULTI_PANE_SETTINGS_DEEP_LINK"/>
     <uses-permission android:name="com.samsung.android.settings.permission.SETTINGS"/>
+    <uses-permission android:name="io.mesalabs.unica.permission.LOCAL_SUMMARY"/>
     <queries>
         <package android:name="com.samsung.android.scloud.config"/>
         <package android:name="com.samsung.android.intellivoiceservice"/>
+        <package android:name="io.mesalabs.unica.localsummary"/>
+        <provider android:authorities="io.mesalabs.unica.localsummary"/>
         <intent>
             <action android:name="com.samsung.android.scs.asr.action.SEARCH_LANGPACK"/>
         </intent>

