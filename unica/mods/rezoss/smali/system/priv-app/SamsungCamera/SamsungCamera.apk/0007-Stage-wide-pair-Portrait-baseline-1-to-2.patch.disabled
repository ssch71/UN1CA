+    sget-object v7, Ll9/x;->BACK_NORMAL_DUAL_PORTRAIT:Ll9/x;
+
+    goto :goto_wide_baseline_table
+
+    :cond_wide_baseline_table_default
     sget-object v7, Ll9/x;->BACK_SEAMLESS_ZOOM:Ll9/x;
+
+    :goto_wide_baseline_table

     invoke-virtual {v1, v14, v7}, Landroid/util/SparseArray;->put(ILjava/lang/Object;)V

