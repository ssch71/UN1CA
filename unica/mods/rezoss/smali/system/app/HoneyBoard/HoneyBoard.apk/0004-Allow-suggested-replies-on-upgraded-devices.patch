--- a/smali_classes2/nj/d.smali
+++ b/smali_classes2/nj/d.smali
@@ -1960,6 +1960,8 @@
     move v5, v2

     :goto_1f
+    const/4 v5, 0x1
+
     sput-boolean v5, Lnj/d;->O:Z

     invoke-direct {v0}, Lnj/d;->n0()Lqn/b;
