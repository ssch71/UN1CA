@@ -1666,7 +1666,7 @@

     const-string v1, "[SuggestedReplies]"

-    if-nez v0, :cond_0
+    goto :cond_0

     iget-object p0, p0, Lcom/samsung/android/honeyboard/base/suggestedreplies/receiver/SuggestedRepliesReceiver;->c:Llo/b;

diff --git a/smali_classes3/com/samsung/android/honeyboard/textboard/suggestedreplies/viewmodel/SuggestedRepliesViewModel.smali b/smali_classes3/com/samsung/android/honeyboard/textboard/suggestedreplies/viewmodel/SuggestedRepliesViewModel.smali
