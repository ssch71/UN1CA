--- /dev/null
+++ b/wlan/wonder/include/wonder/s23u_provider.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _WONDER_S23U_PROVIDER_H
+#define _WONDER_S23U_PROVIDER_H
+
+#include <linux/device.h>
+
+/* Optional board registration for devices without a Wonder DT node. */
+#define S23U_WONDER_PROVIDER_MAGIC 0x57545031U
+struct s23u_wonder_platform_data {
+	u32 magic;
+	struct device *provider;
+};
+
+int cnss_set_vendor_wonder_priv_data(const void *priv_data);
+#endif
