; Fixed-path, boot-only certificate-store worker. No network or app hooks.
(type unica_movecert)
(roletype object_r unica_movecert)
(typeattributeset domain (unica_movecert))
(typeattributeset coredomain (unica_movecert))
(type unica_movecert_exec)
(roletype object_r unica_movecert_exec)
(typeattributeset file_type (unica_movecert_exec))
(typeattributeset exec_type (unica_movecert_exec))
(typeattributeset system_file_type (unica_movecert_exec))
(allow init unica_movecert_exec (file (read open getattr map execute)))
(allow init unica_movecert (process (transition siginh rlimitinh)))
(allow unica_movecert init (process (sigchld)))
(allow unica_movecert init (fd (use)))
(allow unica_movecert unica_movecert_exec (file (read open getattr map execute entrypoint)))
(type unica_movecert_data)
(type unica_movecert_request)
(type unica_movecert_mount)
(roletype object_r unica_movecert_data)
(roletype object_r unica_movecert_request)
(roletype object_r unica_movecert_mount)
(typeattributeset file_type (unica_movecert_data unica_movecert_request unica_movecert_mount))
(typeattributeset data_file_type (unica_movecert_data unica_movecert_request))
(typeattributeset core_data_file_type (unica_movecert_data unica_movecert_request))
(allow system_app unica_movecert_data (dir (search getattr)))
(allow system_app unica_movecert_data (file (read open getattr)))
(allow system_app unica_movecert_request (dir (search read open getattr write add_name remove_name)))
(allow system_app unica_movecert_request (file (create read write open getattr setattr rename unlink)))
(allow unica_movecert unica_movecert_data (dir (search read open getattr write add_name remove_name)))
(allow unica_movecert unica_movecert_data (file (create read write open getattr setattr rename unlink)))
(allow unica_movecert unica_movecert_request (dir (search read open getattr write add_name remove_name)))
(allow unica_movecert unica_movecert_request (file (create read write open getattr setattr rename unlink)))
(allow unica_movecert system_data_file (dir (search getattr)))
(allow unica_movecert misc_user_data_file (dir (search read open getattr)))
(allow unica_movecert misc_user_data_file (file (read open getattr)))
(allow unica_movecert self (capability (sys_admin chown)))
(allow unica_movecert system_file (dir (search read open getattr mounton)))
(allow unica_movecert system_file (file (read open getattr execute map)))
(allow unica_movecert system_file (lnk_file (read getattr)))
(allow unica_movecert apex_mnt_dir (dir (search read open getattr)))
(allow unica_movecert apex_mnt_dir (lnk_file (read getattr)))
(allow unica_movecert unica_movecert_mount (dir (search getattr mounton)))
(allow unica_movecert system_security_cacerts_file (dir (create search read open getattr write add_name mounton)))
(allow unica_movecert system_security_cacerts_file (file (create read write open getattr)))
(allow unica_movecert tmpfs (filesystem (mount remount unmount relabelfrom relabelto)))
(allow unica_movecert system_security_cacerts_file (filesystem (mount remount unmount relabelfrom relabelto)))
(allow system_security_cacerts_file tmpfs (filesystem (associate)))
; context= first relabels the tmpfs superblock, then labels its root inode
; against that now-CA-labeled superblock (SELinux may_context_mount_inode_relabel).
(allow system_security_cacerts_file system_security_cacerts_file (filesystem (associate)))
(allow unica_movecert null_device (chr_file (read write open getattr)))
