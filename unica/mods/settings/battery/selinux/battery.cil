(genfscon sysfs "/module/pcie_aspm/parameters/policy" (u object_r unica_battery_sysfs ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00000.qcom,pcie/pci0000:00/0000:00:00.0/0000:01:00.0/power/control" (u object_r unica_battery_sysfs ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00000.qcom,pcie/pci0000:00/0000:00:00.0/0000:01:00.0/power/wakeup" (u object_r unica_battery_sysfs ((s0) (s0))))
