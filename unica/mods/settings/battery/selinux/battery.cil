; Fixed-control native worker. No shell, Binder, execmem or network grants.
(type unica_battery)
(roletype object_r unica_battery)
(typeattributeset domain (unica_battery))
(typeattributeset coredomain (unica_battery))
(type unica_battery_exec)
(roletype object_r unica_battery_exec)
(typeattributeset file_type (unica_battery_exec))
(typeattributeset exec_type (unica_battery_exec))
(typeattributeset system_file_type (unica_battery_exec))
(allow init unica_battery_exec (file (read open getattr map execute)))
(allow init unica_battery (process (transition siginh rlimitinh)))
(allow unica_battery init (process (sigchld)))
(allow unica_battery init (fd (use)))
(allow unica_battery unica_battery_exec (file (read open getattr map execute entrypoint)))
