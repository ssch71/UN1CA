; SPDX-License-Identifier: GPL-3.0-or-later
; On-demand static worker. No shell, networking, Binder or Linux capabilities.
(type unica_gpu)
(roletype object_r unica_gpu)
(typeattributeset domain (unica_gpu))
(typeattributeset coredomain (unica_gpu))
(type unica_gpu_exec)
(roletype object_r unica_gpu_exec)
(typeattributeset file_type (unica_gpu_exec))
(typeattributeset exec_type (unica_gpu_exec))
(typeattributeset system_file_type (unica_gpu_exec))
(allow init unica_gpu_exec (file (read open getattr map execute)))
(allow init unica_gpu (process (transition siginh rlimitinh)))
(allow unica_gpu init (process (sigchld)))
(allow unica_gpu init (fd (use)))
(allow unica_gpu unica_gpu_exec (file (read open getattr map execute entrypoint)))
(type unica_gpu_data)
(type unica_gpu_request)
(type unica_gpu_response)
(type unica_gpu_backup)
(type unica_gpu_archive)
(roletype object_r unica_gpu_data)
(roletype object_r unica_gpu_request)
(roletype object_r unica_gpu_response)
(roletype object_r unica_gpu_backup)
(roletype object_r unica_gpu_archive)
(typeattributeset file_type (unica_gpu_data unica_gpu_request unica_gpu_response unica_gpu_backup unica_gpu_archive))
(typeattributeset data_file_type (unica_gpu_data unica_gpu_request unica_gpu_response unica_gpu_archive))
(typeattributeset core_data_file_type (unica_gpu_data unica_gpu_request unica_gpu_response unica_gpu_archive))
(type unica_gpu_block)
(type unica_gpu_vbmeta)
(roletype object_r unica_gpu_block)
(roletype object_r unica_gpu_vbmeta)
(type unica_gpu_prop)
(roletype object_r unica_gpu_prop)
(typeattributeset property_type (unica_gpu_prop))
(typeattributeset system_property_type (unica_gpu_prop))
(typeattributeset system_internal_property_type (unica_gpu_prop))
(allow system_app unica_gpu_data (dir (search getattr)))
(allow system_app unica_gpu_request (dir (search read open getattr write add_name remove_name)))
(allow system_app unica_gpu_request (file (create read write open getattr setattr rename unlink)))
(allow system_app unica_gpu_response (dir (search read open getattr)))
(allow system_app unica_gpu_response (file (read open getattr)))
(allow system_app unica_gpu_backup (dir (search getattr)))
(allow system_app unica_gpu_backup (file (read open getattr)))
(allow system_app unica_gpu_prop (property_service (set)))
(allow system_app unica_gpu_prop (file (read open getattr map)))
(allow system_app property_socket (sock_file (write)))
(allow system_app init (unix_stream_socket (connectto)))
(allow unica_gpu system_data_file (dir (search getattr)))
(allow unica_gpu unica_gpu_data (dir (search read open getattr)))
(allow unica_gpu unica_gpu_request (dir (search getattr)))
(allow unica_gpu unica_gpu_request (file (read open getattr)))
(allow unica_gpu unica_gpu_response (dir (search read open getattr write add_name remove_name)))
(allow unica_gpu unica_gpu_response (file (create read write open getattr setattr rename unlink)))
(allow unica_gpu cache_file (dir (search getattr)))
(allow unica_gpu unica_gpu_backup (dir (create search read open getattr write add_name remove_name rmdir)))
(allow unica_gpu unica_gpu_backup (file (create read write open getattr setattr rename unlink lock link)))
(allow unica_gpu device (dir (search getattr)))
(allow unica_gpu block_device (dir (search getattr)))
(allow unica_gpu block_device (lnk_file (read getattr)))
(allow unica_gpu unica_gpu_block (blk_file (read write open getattr ioctl)))
(allowx unica_gpu unica_gpu_block (ioctl blk_file (0x1272)))
(allow unica_gpu unica_gpu_vbmeta (blk_file (read open getattr)))
(allow unica_gpu system_file (dir (search getattr)))
(allow unica_gpu system_file (file (read open getattr)))
(allow unica_gpu vendor_file (dir (search getattr)))
(allow unica_gpu vendor_file (file (read open getattr)))
(allow unica_gpu vendor_file (lnk_file (read getattr)))
(allow unica_gpu labeledfs (filesystem (getattr)))
(allow unica_gpu cache_file (filesystem (getattr)))

; Private /data archives are worker-only; Settings exports the active cache ZIP.
(allow unica_gpu unica_gpu_archive (dir (create search read open getattr write add_name remove_name)))
(allow unica_gpu unica_gpu_archive (file (create read write open getattr setattr rename unlink)))
