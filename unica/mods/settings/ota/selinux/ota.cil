(type unica_ota)
(roletype object_r unica_ota)
(typeattributeset domain (unica_ota))
(typeattributeset coredomain (unica_ota))
(type unica_ota_exec)
(roletype object_r unica_ota_exec)
(typeattributeset file_type (unica_ota_exec))
(typeattributeset exec_type (unica_ota_exec))
(typeattributeset system_file_type (unica_ota_exec))
(allow init unica_ota_exec (file (read open getattr map execute)))
(allow init unica_ota (process (transition siginh rlimitinh)))
(allow unica_ota init (process (sigchld)))
(allow unica_ota init (fd (use)))
(allow unica_ota unica_ota_exec (file (read open getattr map execute entrypoint)))
(type unica_ota_data)
(type unica_ota_request)
(type unica_ota_staged)
(roletype object_r unica_ota_data)
(roletype object_r unica_ota_request)
(roletype object_r unica_ota_staged)
(typeattributeset file_type (unica_ota_data unica_ota_request unica_ota_staged))
(typeattributeset data_file_type (unica_ota_data unica_ota_request unica_ota_staged))
(typeattributeset core_data_file_type (unica_ota_data unica_ota_request unica_ota_staged))
(type unica_ota_prop)
(roletype object_r unica_ota_prop)
(typeattributeset property_type (unica_ota_prop))
(typeattributeset system_property_type (unica_ota_prop))
(typeattributeset system_internal_property_type (unica_ota_prop))
(allow system_app unica_ota_data (dir (search getattr)))
(allow system_app unica_ota_request (dir (search read open getattr write add_name remove_name)))
; Android ZipFile maps the central directory of the copied OTA during verification.
(allow system_app unica_ota_request (file (create read write open getattr setattr rename unlink map)))
(allow system_app unica_ota_staged (dir (search read open getattr)))
(allow system_app unica_ota_staged (file (read open getattr)))
(allow system_app unica_ota_prop (property_service (set)))
(allow system_app unica_ota_prop (file (read open getattr map)))
(allow unica_ota system_data_file (dir (search getattr)))
(allow unica_ota unica_ota_data (dir (search getattr)))
(allow unica_ota unica_ota_request (dir (search getattr)))
(allow unica_ota unica_ota_request (file (read open getattr)))
(allow unica_ota unica_ota_staged (dir (search read open getattr write add_name remove_name)))
(allow unica_ota unica_ota_staged (file (create read write open getattr setattr rename unlink lock)))
(allow unica_ota cache_file (dir (search read open getattr write add_name remove_name)))
(allow unica_ota cache_file (file (create read write open getattr setattr rename unlink link)))
; Samsung labels /cache/recovery separately from /cache/unica-ota.
(allow unica_ota cache_recovery_file (dir (search read open getattr write add_name remove_name)))
(allow unica_ota cache_recovery_file (file (create read write open getattr setattr rename unlink link)))
(allow unica_ota self (capability (chown)))
(allow unica_ota system_file (file (read open getattr map execute)))
(allow unica_ota system_file (dir (search getattr)))
(allow unica_ota tmpfs (file (read write open getattr)))
(allow unica_ota null_device (chr_file (read write open getattr)))
(allow system_app property_socket (sock_file (write)))
(allow system_app init (unix_stream_socket (connectto)))
(allow unica_ota labeledfs (filesystem (getattr)))
