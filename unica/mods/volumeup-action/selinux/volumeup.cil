; Fixed recovery request only; no direct power-control, reboot capability or shell.
(type unica_volumeup)
(roletype object_r unica_volumeup)
(typeattributeset domain (unica_volumeup))
(typeattributeset coredomain (unica_volumeup))
(type unica_volumeup_exec)
(roletype object_r unica_volumeup_exec)
(typeattributeset file_type (unica_volumeup_exec))
(typeattributeset exec_type (unica_volumeup_exec))
(typeattributeset system_file_type (unica_volumeup_exec))
(allow init unica_volumeup_exec (file (read open getattr map execute)))
(allow init unica_volumeup (process (transition siginh rlimitinh)))
(allow unica_volumeup init (process (sigchld)))
(allow unica_volumeup init (fd (use)))
(allow unica_volumeup unica_volumeup_exec (file (read open getattr map execute entrypoint)))
(allow unica_volumeup device (dir (search getattr)))
(allow unica_volumeup input_device (dir (search read open getattr)))
(allow unica_volumeup input_device (chr_file (read open getattr ioctl)))
(allowx unica_volumeup input_device (ioctl chr_file (0x4502 0x4518 0x4521)))
(allow unica_volumeup kmsg_device (chr_file (open write)))
; stderr inherited from init can refer to /dev/null.
(allow unica_volumeup null_device (chr_file (read write open getattr)))

(type unica_volumeup_request_prop)
(roletype object_r unica_volumeup_request_prop)
(typeattributeset property_type (unica_volumeup_request_prop))
(typeattributeset system_property_type (unica_volumeup_request_prop))
(typeattributeset system_internal_property_type (unica_volumeup_request_prop))
(allow unica_volumeup unica_volumeup_request_prop (property_service (set)))
(allow unica_volumeup property_service_version_prop (file (read open getattr map)))
(allow unica_volumeup property_socket (sock_file (write)))
(allow unica_volumeup init (unix_stream_socket (connectto)))
(allow unica_volumeup unica_volumeup (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))

; Recovery-created disable marker: existence check only, no contents or writes.
(allow unica_volumeup metadata_file (dir (search getattr)))
(allow unica_volumeup metadata_file (file (getattr)))
