on post-fs-data
    mkdir /data/misc/unica-teesim 0700 root root
    restorecon_recursive /data/misc/unica-teesim

service unica-teesim /system/bin/sh /system/etc/unica/tee-simulator/daemon.sh
    class late_start
    user root
    group root readproc
    seclabel u:r:unica_teesim:s0
    disabled
    restart_period 30

on property:sys.boot_completed=1
    start unica-teesim
