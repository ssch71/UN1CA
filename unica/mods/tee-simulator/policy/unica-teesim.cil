; Dedicated enforcing domain. This is not a permissive root-manager domain.
(type unica_teesim)
(roletype r unica_teesim)
(typeattributeset domain (unica_teesim))
(typeattributeset coredomain (unica_teesim))
(typeattributeset mlstrustedsubject (unica_teesim))
(type unica_teesim_data_file)
(roletype object_r unica_teesim_data_file)
(typeattributeset file_type (unica_teesim_data_file))
(typeattributeset data_file_type (unica_teesim_data_file))
(typeattributeset core_data_file_type (unica_teesim_data_file))
(type unica_teesim_tmpfs)
(roletype object_r unica_teesim_tmpfs)
(typeattributeset file_type (unica_teesim_tmpfs))
(type unica_teesim_status_prop)
(roletype object_r unica_teesim_status_prop)
(typeattributeset property_type (unica_teesim_status_prop))
(typeattributeset system_property_type (unica_teesim_status_prop))
(typeattributeset system_internal_property_type (unica_teesim_status_prop))

(allow init unica_teesim (process (transition siginh rlimitinh)))
(allow unica_teesim init (process (sigchld)))
(allow unica_teesim shell_exec (file (entrypoint)))
(allow unica_teesim self (process (fork sigchld signull signal getsched setsched getcap setrlimit execmem)))
(allow unica_teesim self (capability (sys_ptrace dac_override dac_read_search)))
(allow unica_teesim system_file_type (dir (search read open getattr)))
(allow unica_teesim system_file_type (file (read open getattr map execute execute_no_trans)))
(allow unica_teesim system_file_type (lnk_file (read getattr)))
(allow unica_teesim vendor_file (dir (search read open getattr)))
(allow unica_teesim vendor_configs_file (dir (search read open getattr)))
(allow unica_teesim vendor_configs_file (file (read open getattr map)))
(allow unica_teesim apex_mnt_dir (dir (search read open getattr)))
(allow unica_teesim apex_info_file (file (read open getattr map)))
(allow unica_teesim apex_data_file (dir (search)))
(allow unica_teesim apex_art_data_file (dir (search)))
(allow unica_teesim dalvikcache_data_file (dir (search read open getattr)))
(allow unica_teesim dalvikcache_data_file (file (read open getattr map execute)))
(allow unica_teesim proc (dir (search read open getattr)))
(allow unica_teesim proc (file (read open getattr)))
(allow unica_teesim proc_meminfo (file (read open getattr)))
(allow unica_teesim proc_overcommit_memory (file (read open getattr)))
; /proc/<pid> entries carry their process domain; ptrace is granted only for keystore.
(allow unica_teesim domain (dir (search read open getattr)))
(allow unica_teesim domain (file (read open getattr)))
(allow unica_teesim domain (lnk_file (read getattr)))
(allow unica_teesim keystore (process (ptrace getattr signull)))
(allow unica_teesim keystore (fd (use)))
(allow unica_teesim self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow unica_teesim self (unix_dgram_socket (create connect read write getattr getopt setopt shutdown)))
(allow unica_teesim keystore (unix_stream_socket (connectto)))
; SCM_RIGHTS uses an abstract datagram socket in keystore while the target is stopped.
(allow unica_teesim keystore (unix_dgram_socket (sendto)))
(allow unica_teesim keystore_data_file (dir (search)))
(allow unica_teesim keystore_data_file (sock_file (read write open getattr)))
(allow keystore self (unix_stream_socket (create bind listen accept read write getattr getopt setopt shutdown)))
(allow keystore keystore_data_file (sock_file (create unlink read write open getattr setattr)))
; Injector memfd path, with a system-library fallback. No executable data directory.
(typetransition unica_teesim tmpfs file unica_teesim_tmpfs)
(allow unica_teesim unica_teesim_tmpfs (file (create read write open getattr map execute setattr unlink)))
(allow keystore unica_teesim_tmpfs (file (read open getattr map execute)))
(allow keystore unica_teesim (fd (use)))
(allow keystore unica_teesim (dir (search)))
(allow keystore unica_teesim (lnk_file (read getattr)))
(allow keystore unica_teesim (file (read open getattr)))
(allow unica_teesim self (memfd_file (read write create getattr map execute)))
(allow keystore unica_teesim (memfd_file (read write getattr map execute)))
; Settings' cmd interface, PackageManager, and throwaway hardware attestation harvest.
(allow unica_teesim binder_device (chr_file (read write open getattr ioctl map)))
(allow unica_teesim servicemanager (binder (call transfer)))
(allow unica_teesim servicemanager (fd (use)))
(allow servicemanager unica_teesim (binder (transfer)))
(allow unica_teesim system_server (binder (call transfer)))
(allow system_server unica_teesim (binder (call transfer)))
(allow unica_teesim system_server (fd (use)))
; SettingsProvider's shellCommand writes its reply through the daemon-owned pipe.
(allow system_server unica_teesim (fd (use)))
(allow system_server unica_teesim (fifo_file (read write getattr ioctl)))
(allow unica_teesim keystore (binder (call transfer)))
(allow keystore unica_teesim (binder (call transfer)))
(allow unica_teesim keystore (keystore2_key (delete get_info rebind update use)))
(allow unica_teesim system_server_service (service_manager (find)))
(allow unica_teesim keystore_service (service_manager (find)))
(allow unica_teesim permission_service (service_manager (find)))
(allow unica_teesim activity_service (service_manager (find)))
(allow unica_teesim package_service (service_manager (find)))
(allow unica_teesim user_service (service_manager (find)))
(allow unica_teesim system_data_root_file (dir (search)))
(allow unica_teesim system_data_file (dir (search read open getattr watch)))
(allow unica_teesim system_userdir_file (dir (search read open getattr watch)))
(allow unica_teesim unica_teesim_data_file (dir (create read write open getattr search add_name remove_name setattr)))
(allow unica_teesim unica_teesim_data_file (file (create read write open getattr map rename unlink setattr lock)))
(allow init unica_teesim_data_file (dir (create read write open getattr search add_name remove_name setattr relabelfrom relabelto)))
(allow init unica_teesim_data_file (file (read write open getattr setattr relabelfrom relabelto)))
(allow unica_teesim system_prop (file (read open getattr map)))
(allow unica_teesim build_prop (file (read open getattr map)))
(allow unica_teesim build_attestation_prop (file (read open getattr map)))
(allow unica_teesim bootloader_prop (file (read open getattr map)))
(allow unica_teesim fingerprint_prop (file (read open getattr map)))
(allow unica_teesim exported_default_prop (file (read open getattr map)))
(allow unica_teesim vendor_security_patch_level_prop (file (read open getattr map)))
(allow unica_teesim serialno_prop (file (read open getattr map)))
(allow domain unica_teesim_status_prop (file (read open getattr map)))
(allow unica_teesim property_socket (sock_file (write)))
(allow unica_teesim init (unix_stream_socket (connectto)))
(allow unica_teesim unica_teesim_status_prop (property_service (set)))
(allow unica_teesim null_device (chr_file (read write open getattr ioctl)))
(allow unica_teesim zero_device (chr_file (read write open getattr map)))
(allow unica_teesim random_device (chr_file (read open getattr)))
(allow unica_teesim logdw_socket (sock_file (write)))
(allow unica_teesim logd (unix_dgram_socket (sendto)))
(allow unica_teesim cgroup (dir (search read open getattr)))
(allow unica_teesim cgroup (file (read open getattr)))
(allow unica_teesim cgroup_v2 (dir (search read open getattr)))
(allow unica_teesim cgroup_v2 (file (read open getattr)))

; Only list module directories for arbitration; never read root-manager state/key files.
(allow unica_teesim adb_data_file (dir (search read open getattr)))

; UID-1000 native Settings administration only; signing XML stays in SettingsProvider.
(type unica_teesim_service)
(roletype object_r unica_teesim_service)
(typeattributeset service_manager_type (unica_teesim_service))
(allow unica_teesim unica_teesim_service (service_manager (add find)))
(allow system_app unica_teesim_service (service_manager (find)))
(allow system_app unica_teesim (binder (call transfer)))
(allow unica_teesim system_app (binder (call transfer)))
; Snapshot reads only. Deletion uses keystore2's owner-scoped binder API.
(allow unica_teesim keystore_data_file (dir (read open getattr)))
(allow unica_teesim keystore_data_file (file (read open getattr)))
(allow unica_teesim self (capability (setuid)))

(allow unica_teesim remote_prov_prop (file (read open getattr map)))
